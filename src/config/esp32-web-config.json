{
  "configParams": {
    "menuItems": {
      "display": {
        "id": "display",
        "label": "Display",
        "title": "Display Control Section",
        "components": {
          "textInput": {
            "type": "textInput",
            "id": "displayTextInput",
            "position": 1,
            "params": {
              "size": 3,
              "label": "Text input",
              "placeholder": "Input your text",
              "defaultValue": ""
            }
          },
          "sendTextButton": {
            "type": "button",
            "id": "sendTextButton",
            "position": 2,
            "params": {
              "size": 4,
              "label": "Send text",
              "action": "sendText"
            }
          }
        }
      },
      "led": {
        "id": "led",
        "label": "LED",
        "title": "LED Control Section",
        "defaultState": {
          "isOn": false,
          "brightness": 50,
          "effect": "none",
          "switchColors": false,
          "effectInterval": 1000,
          "colors": ["#FF0000", "#00FF00", "#0000FF"]
        },
        "components": {
          "powerSwitch": {
            "type": "toggleSwitch",
            "id": "ledPowerSwitch",
            "position": 1,
            "params": {
              "size": 3,
              "label": "LED Power",
              "dependency": "general",
              "checked": false
            }
          },
          "brightness": {
            "type": "rangeSlider",
            "id": "ledBrightnessSlider",
            "position": 2,
            "params": {
              "size": 3,
              "label": "LED brightness",
              "unit": "%",
              "min": 1,
              "max": 100,
              "step": 1,
              "defaultValue": 90,
              "dependency": {
                "componentId": "ledPowerSwitch",
                "condition": "checked"
              }
            }
          },
          "colorPicker": {
            "type": "colorPicker",
            "id": "ledColorPicker",
            "position": 3,
            "params": {
              "size": 3,
              "label": "LED color",
              "defaultValue": "#FF0000",
              "dependency": {
                "componentId": "ledPowerSwitch",
                "condition": "checked"
              }
            }
          },
          "effectSelector": {
            "type": "dropdown",
            "id": "ledEffectSelector",
            "position": 4,
            "params": {
              "size": 3,
              "label": "LED effect",
              "options": [
                {
                  "type": "blink",
                  "label": "Blink"
                },
                {
                  "type": "pulse",
                  "label": "Pulse"
                },
                {
                  "type": "none",
                  "label": "None"
                }
              ],
              "defaultValue": "none",
              "dependency": {
                "componentId": "ledPowerSwitch",
                "condition": "checked"
              }
            }
          },
          "codeSnippet": {
            "type": "codeSnippet",
            "id": "ledCodeSnippet",
            "position": 5,
            "params": {
              "size": 3,
              "label": "LED Code Snippet",
              "language": "json",
              "defaultValue": "{\n  \"isOn\": false,\n  \"brightness\": 50,\n  \"effect\": \"none\",\n  \"switchColors\": false,\n  \"effectInterval\": 1000,\n  \"colors\": [\n    \"#FF0000\",\n    \"#00FF00\",\n    \"#0000FF\"\n  ]\n}",
              "dependency": {
                "componentId": "ledPowerSwitch",
                "condition": "checked"
              }
            }
          }
        }
      },
      "sound": {
        "id": "sound",
        "label": "Sound",
        "title": "Sound Control Section",
        "components": {
          "volumeSlider": {
            "type": "rangeSlider",
            "id": "volumeSlider",
            "position": 1,
            "params": {
              "size": 3,
              "label": "Volume",
              "unit": "%",
              "min": 0,
              "max": 100,
              "step": 1,
              "defaultValue": 50
            }
          },
          "muteButton": {
            "type": "button",
            "id": "muteButton",
            "position": 2,
            "params": {
              "size": 3,
              "label": "Mute",
              "action": "muteSound"
            }
          }
        }
      },
      "settings": {
        "id": "settings",
        "label": "Settings",
        "title": "Settings Section",
        "components": {
          "resetButton": {
            "type": "button",
            "id": "resetButton",
            "position": 1,
            "params": {
              "size": 3,
              "label": "Reset to Defaults"
            }
          },
          "updateButton": {
            "type": "button",
            "id": "updateButton",
            "position": 2,
            "params": {
              "size": 3,
              "label": "Update Firmware",
              "action": "updateFirmware"
            }
          }
        }
      }
    }
  }
}
