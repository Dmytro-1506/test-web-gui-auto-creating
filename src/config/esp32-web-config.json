{
  "configParams": {
    "menuItems": {
      "deviceOverview": {
        "id": "deviceOverview",
        "label": "Device Overview",
        "title": "Device Overview Section",
        "defaultState": {
          "name": "ESP32 Device",
          "connected": false
        },
        "components": {
          "syncStatusButton": {
            "type": "button",
            "id": "syncStatusButton",
            "position": 0,
            "params": {
              "size": 3,
              "label": "Sync Status",
              "action": "sendCommand",
              "commandRef": "getStatus"
            }
          },
          "display": {
            "type": "infoBox",
            "id": "displayOverview",
            "position": 1,
            "params": {
              "size": 3,
              "title": "Display Overview",
              "content": "Display is currently off.",
              "variant": "info",
              "enabled": true,
              "width": 320,
              "height": 170,
              "unit": "px",
              "commandRef": "getStatus"
            }
          },
          "led": {
            "type": "infoBox",
            "id": "ledOverview",
            "position": 2,
            "params": {
              "size": 3,
              "title": "LED Overview",
              "content": "LED is currently off.",
              "variant": "info",
              "enabled": true,
              "color": "#FF0000",
              "brightness": 50,
              "effect": "none",
              "commandRef": "getStatus"
            }
          },
          "sound": {
            "type": "infoBox",
            "id": "soundOverview",
            "position": 3,
            "params": {
              "size": 3,
              "title": "Sound Overview",
              "content": "Sound is currently off.",
              "variant": "info",
              "enabled": true,
              "commandRef": "getStatus"
            }
          },
          "buttonsSection": {
            "type": "infoBox",
            "id": "buttonsSection",
            "position": 4,
            "params": {
              "size": 3,
              "title": "Buttons Section",
              "content": "Button controls for the device.",
              "variant": "info",
              "enabled": true,
              "commandRef": "getStatus"
            }
          },
          "systemInfo": {
            "type": "infoBox",
            "id": "systemInfo",
            "position": 5,
            "params": {
              "title": "System Information Section",
              "label": "System Info",
              "commandRef": "getStatus",
              "content": "",
              "wifi": {
                "connected": true,
                "ssid": "MyWiFi",
                "ip": "192.168.178.52",
                "rssi": -55
              },
              "bluetooth": {
                "enabled": false,
                "connected": false
              },
              "battery": {
                "voltage": 4.2,
                "percentage": 100
              }
            }
          }
        }
      },
      "display": {
        "id": "display",
        "label": "Display",
        "title": "Display Control Section",
        "components": {
          "textInput": {
            "type": "textInput",
            "id": "displayTextInput",
            "position": 1,
            "params": {
              "size": 3,
              "label": "Text input",
              "placeholder": "Input your text",
              "defaultValue": ""
            }
          },
          "sendTextButton": {
            "type": "button",
            "id": "sendTextButton",
            "position": 2,
            "params": {
              "size": 4,
              "label": "Send text",
              "action": "sendText"
            }
          }
        }
      },
      "led": {
        "id": "led",
        "label": "LED",
        "title": "LED Control Section",
        "defaultState": {
          "isOn": false,
          "brightness": 50,
          "effect": "none",
          "switchColors": false,
          "effectInterval": 1000,
          "colors": ["#FF0000", "#00FF00", "#0000FF"]
        },
        "components": {
          "powerSwitch": {
            "type": "toggleSwitch",
            "id": "ledPowerSwitch",
            "position": 1,
            "params": {
              "size": 3,
              "label": "LED Power",
              "dependency": "general",
              "checked": false
            }
          },
          "brightness": {
            "type": "rangeSlider",
            "id": "ledBrightnessSlider",
            "position": 2,
            "params": {
              "size": 3,
              "label": "LED brightness",
              "unit": "%",
              "min": 10,
              "max": 100,
              "step": 10,
              "defaultValue": 50,
              "dependency": {
                "componentId": "ledPowerSwitch",
                "condition": "checked"
              }
            }
          },
          "effectSelector": {
            "type": "dropdown",
            "id": "ledEffectSelector",
            "position": 3,
            "params": {
              "size": 3,
              "label": "LED effect",
              "options": [
                {
                  "type": "blink",
                  "label": "Blink"
                },
                {
                  "type": "pulse",
                  "label": "Pulse"
                },
                {
                  "type": "none",
                  "label": "None"
                }
              ],
              "defaultValue": "none",
              "dependency": {
                "componentId": "ledPowerSwitch",
                "condition": "checked"
              }
            }
          },
          "effectInterval": {
            "type": "rangeSlider",
            "id": "ledEffectIntervalSlider",
            "position": 4,
            "params": {
              "size": 3,
              "label": "Effect interval",
              "unit": "ms",
              "min": 100,
              "max": 3000,
              "step": 100,
              "defaultValue": 1000,
              "dependency": {
                "componentId": "ledPowerSwitch",
                "condition": "checked"
              }
            }
          },
          "colorSwitch": {
            "type": "toggleSwitch",
            "id": "ledColorSwitch",
            "position": 6,
            "params": {
              "size": 3,
              "label": "Switch colors",
              "checked": false,
              "dependency": {
                "componentId": "ledPowerSwitch",
                "condition": "checked"
              }
            }
          },
          "colorsContainer": {
            "type": "container",
            "id": "ledColorsContainer",
            "position": 7,
            "params": {
              "size": 3,
              "label": "LED colors",
              "defaultValue": "#FF0000",
              "maxItems": 5,
              "dependency": {
                "componentId": "ledColorSwitch",
                "condition": "checked"
              }
            }
          },
          "codeSnippet": {
            "type": "codeSnippet",
            "id": "ledCodeSnippet",
            "position": 8,
            "params": {
              "size": 3,
              "label": "LED Command",
              "language": "json",
              "commandRef": "setLED",
              "defaultValue": "{\n  \"isOn\": false,\n  \"brightness\": 50,\n  \"effect\": \"none\",\n  \"switchColors\": false,\n  \"effectInterval\": 1000,\n  \"colors\": [\n    \"#FF0000\",\n    \"#00FF00\",\n    \"#0000FF\"\n  ]\n}",
              "dependency": {
                "componentId": "ledPowerSwitch",
                "condition": "checked"
              }
            }
          },
          "button": {
            "type": "button",
            "id": "setLED",
            "position": 9,
            "params": {
              "size": 3,
              "label": "Apply LED Settings",
              "action": "sendCommand",
              "commandRef": "setLED",
              "dependency": {
                "componentId": "ledPowerSwitch",
                "condition": "checked"
              }
            }
          }
        }
      },
      "sound": {
        "id": "sound",
        "label": "Sound",
        "title": "Sound Control Section",
        "components": {
          "volumeSlider": {
            "type": "rangeSlider",
            "id": "volumeSlider",
            "position": 1,
            "params": {
              "size": 3,
              "label": "Volume",
              "unit": "%",
              "min": 0,
              "max": 100,
              "step": 1,
              "defaultValue": 50
            }
          },
          "muteButton": {
            "type": "button",
            "id": "muteButton",
            "position": 2,
            "params": {
              "size": 3,
              "label": "Mute",
              "action": "muteSound"
            }
          }
        }
      },
      "settings": {
        "id": "settings",
        "label": "Settings",
        "title": "Settings Section",
        "components": {
          "resetButton": {
            "type": "button",
            "id": "resetButton",
            "position": 1,
            "params": {
              "size": 3,
              "label": "Reset to Defaults"
            }
          },
          "updateButton": {
            "type": "button",
            "id": "updateButton",
            "position": 2,
            "params": {
              "size": 3,
              "label": "Update Firmware",
              "action": "updateFirmware"
            }
          }
        }
      }
    }
  }
}
